{
  "plugins": [
    "remark-preset-lint-recommended"
  ],
  "settings": {
    "bullet": "-",
    "emphasis": "*",
    "fence": "`",
    "listItemIndent": "one",
    "rule": "-",
    "ruleRepetition": 3,
    "ruleSpaces": false,
    "strong": "*"
  },
  "remarkPresetLintRecommended": {
    "no-undefined-references": false,
    "no-unused-definitions": false,
    "no-missing-blank-lines": false,
    "no-multiple-toplevel-headings": false
  }
}
